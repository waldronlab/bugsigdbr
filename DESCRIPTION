Package: bugsigdbr
Version: 1.17.3
Title: R-side access to published microbial signatures from BugSigDB
Authors@R: c(
    person("Ludwig", "Geistlinger", , "ludwig.geistlinger@gmail.com", role = c("aut", "cre")),
    person("Jennifer", "Wokaty", , "jennifer.wokaty@sph.cuny.edu", role = "aut"),
